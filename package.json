{
  "name": "motorx",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:backend": "npm run dev --workspace @motorx/backend",
    "dev:worker": "npm run dev --workspace @motorx/worker",
    "test": "npm run test --workspaces --if-present"
  }
}