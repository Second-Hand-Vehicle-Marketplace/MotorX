NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# MongoDB Atlas: create a database user, allow your IP in Network Access,
# then copy the Node.js driver connection string.
MONGODB_URI=mongodb+srv://<atlas-user>:<atlas-password>@<cluster>.mongodb.net/motorx?retryWrites=true&w=majority

# Gmail SMTP: enable 2-step verification and create a Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-notification-email@gmail.com
SMTP_PASS=your-gmail-app-password

# Browser-to-backend API URL.
VITE_API_URL=http://localhost:3000/api/v1

# Firebase web app configuration:
# Firebase Console -> Project settings -> Your apps -> Web app.
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Firebase Admin SDK:
# Firebase Console -> Project settings -> Service accounts -> Generate new private key.
# Keep this private. Store newlines as literal \n characters.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_CONTENT\n-----END PRIVATE KEY-----\n"

# Firebase email that receives the MotorX admin role.
OWNER_ADMIN_EMAIL=admin@example.com

# Local Docker Redis. No external Redis account is required.
REDIS_URL=redis://localhost:6379
INVENTORY_QUEUE_NAME=inventory-processing
WORKER_CONCURRENCY=2

# Local Docker MinIO credentials. Docker overrides S3_ENDPOINT internally
# to http://minio:9000; browsers use S3_PUBLIC_ENDPOINT.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=motorx
S3_ACCESS_KEY=motorx
S3_SECRET_KEY=change-this-local-minio-password
S3_FORCE_PATH_STYLE=true

# Optional; current ETL validation and persistence do not require it.
HF_API_KEY=
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2