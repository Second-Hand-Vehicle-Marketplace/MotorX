# ==========================================================
# Application
# ==========================================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:5173

# ==========================================================
# Database
# ==========================================================
# Local development
MONGODB_URI=mongodb://mongodb:27017/motorx

# Production example
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/motorx

# ==========================================================
# Redis / BullMQ
# ==========================================================
REDIS_URL=redis://redis:6379
INVENTORY_QUEUE_NAME=inventory-processing
WORKER_CONCURRENCY=2

# ==========================================================
# Firebase Admin SDK
# ==========================================================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ==========================================================
# Firebase Web SDK (Frontend)
# ==========================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ==========================================================
# API
# ==========================================================
VITE_API_BASE_URL=http://localhost:3000/api/v1

# ==========================================================
# Object Storage (Local MinIO)
# ==========================================================
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=http://localhost:3000/api/v1/listing-images
S3_REGION=us-east-1
S3_BUCKET=motorx-dev
S3_ACCESS_KEY=motorx
S3_SECRET_KEY=motorx123
S3_FORCE_PATH_STYLE=true

# ==========================================================
# AI / Embedding
# ==========================================================
HF_API_KEY=
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ==========================================================
# File Uploads
# ==========================================================
MAX_FILE_SIZE_MB=20
MAX_IMAGE_SIZE_MB=10
MAX_LISTING_IMAGES=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_UPLOAD_TYPES=text/csv

# ==========================================================
# Pagination
# ==========================================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
