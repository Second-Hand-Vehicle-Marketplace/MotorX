# ==========================================================
# Application
# ==========================================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:4173

# ==========================================================
# Database
# ==========================================================
# MongoDB Atlas connection string for the DEVELOPMENT project. Replace every placeholder before startup.
# Never put the production URI here: production reads it from AWS Secrets Manager.
# Use a separate database such as motorx_test for automated tests.
# With NODE_ENV=production the app refuses non-TLS, local, or dev/test-named databases.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/motorx?retryWrites=true&w=majority

# ==========================================================
# Redis / BullMQ
# ==========================================================
REDIS_URL=redis://redis:6379
INVENTORY_QUEUE_NAME=inventory-processing
WORKER_CONCURRENCY=2
ETL_BATCH_SIZE=250
# Port the worker's minimal /health endpoint listens on (checked by compose.yml's healthcheck).
WORKER_HEALTH_PORT=3100
# How often the worker scans for upload/image jobs whose Mongo lease expired (e.g. it crashed
# mid-job) and re-enqueues them, and how many times a job may be reclaimed before it's failed.
JOB_REAPER_INTERVAL_MS=60000
JOB_MAX_RECLAIM_ATTEMPTS=5
# Dealer verification documents (ID cards, business registrations) are deleted from storage
# this many days after the application is approved or rejected. The worker checks hourly.
DEALER_DOCUMENT_RETENTION_DAYS=90
# Jobs still pending after this long are assumed to have lost their queue message and are re-queued.
PENDING_JOB_REENQUEUE_AFTER_MS=120000
# How long backend/worker shutdown waits for in-flight work. Keep below the orchestrator stop timeout (ECS: 30 s).
SHUTDOWN_TIMEOUT_MS=20000
DOCUMENT_RETENTION_INTERVAL_MS=3600000

# ==========================================================
# Abuse controls (backend). Shared across instances through Redis;
# if Redis is down, limits are skipped rather than blocking the API.
# ==========================================================
# Proxies in front of the API: 0 locally, 1 behind the AWS load balancer.
TRUST_PROXY_HOPS=0
RATE_LIMIT_API_PER_MINUTE=300
RATE_LIMIT_SEARCH_PER_MINUTE=30
RATE_LIMIT_UPLOADS_PER_10_MINUTES=20
RATE_LIMIT_LISTING_PHOTOS_PER_10_MINUTES=150
RATE_LIMIT_DEALER_APPLICATIONS_PER_HOUR=5
QUOTA_CSV_UPLOADS_PER_DAY=50
QUOTA_PHOTO_ZIPS_PER_DAY=200
# Draft + active listings per dealer (backend and worker). Keep above 5,000 (SRS bulk import).
MAX_LISTINGS_PER_DEALER=10000
# File uploads buffered in memory at once per backend instance; extra uploads get 503 + Retry-After.
MAX_CONCURRENT_UPLOADS=4
# How long a verified login token is reused before Firebase is asked again (revocation delay).
AUTH_TOKEN_CACHE_TTL_MS=120000

# ==========================================================
# Firebase Admin SDK
# ==========================================================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Preserve escaped newlines when copying the service-account private key.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ==========================================================
# Firebase Web SDK (Frontend)
# ==========================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ==========================================================
# API
# ==========================================================
VITE_API_BASE_URL=http://localhost:3000/api/v1

# ==========================================================
# Object Storage (Local MinIO)
# ==========================================================
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=http://localhost:3000/api/v1/listing-images
S3_REGION=us-east-1
S3_BUCKET=motorx-dev
S3_ACCESS_KEY=motorx
S3_SECRET_KEY=motorx123
S3_FORCE_PATH_STYLE=true

# Optional Docker image overrides.
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest

# ==========================================================
# AI / Embedding
# ==========================================================
# Optional. When empty, backend and worker use the shared local 384-dimension embedding.
HF_API_KEY=
# Listing and query embeddings must always use the same model.
# Run the --all backfill whenever this model changes.
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_TIMEOUT_MS=4000
# Must match the Atlas Vector Search index name on the listings collection.
ATLAS_VECTOR_INDEX=listing_embedding_index

# ==========================================================
# File Uploads
# ==========================================================
MAX_FILE_SIZE_MB=20
MAX_IMAGE_SIZE_MB=10
MAX_LISTING_IMAGES=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_UPLOAD_TYPES=text/csv,application/csv,application/vnd.ms-excel
# Cap for a dealer's bulk vehicle-photos zip (one folder per registration number).
MAX_IMAGE_ZIP_SIZE_MB=50

# ==========================================================
# Notifications - SMTP (Gmail or another SMTP provider)
# Used only by the worker, which sends queued emails (the outbox)
# with retries. The backend does not need these values.
# ==========================================================
EMAIL_OUTBOX_INTERVAL_MS=15000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MotorX <your-email@example.com>"

# ==========================================================
# Pagination
# ==========================================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
